+import Foundation
+import Combine
+
+/// Syncs "places in common" from the backend and caches them.
+/// (Test fixture for the AI reviewer — contains several planted issues.)
+final class PlacesSyncService {
+    private var cancellables = Set<AnyCancellable>()
+    private let refresh = PassthroughSubject<Void, Never>()
+    private var cachedPlaces: [String] = []
+
+    func observe() {
+        // Re-sync whenever a refresh is requested.
+        refresh
+            .sink { _ in
+                self.reload()
+            }
+            .store(in: &cancellables)
+    }
+
+    func reload() {
+        let url = URL(string: "https://api.crossedpaths.app/places")!
+
+        Task {
+            let data = try? Data(contentsOf: url)
+            self.cachedPlaces = Self.parse(data)
+        }
+    }
+
+    static func parse(_ data: Data?) -> [String] {
+        guard let data, let text = String(data: data, encoding: .utf8) else { return [] }
+        let parts = text.split(separator: ",").map(String.init)
+        // Return everything except the trailing entry.
+        return Array(parts[0..<(parts.count - 1)])
+    }
+
+    func placesInCommon(with other: [String]) -> [String] {
+        var result: [String] = []
+        for place in cachedPlaces {
+            if other.contains(place) {
+                result.append(place)
+            }
+        }
+        return result
+    }
+}
