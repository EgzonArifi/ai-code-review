@@ -0,0 +1,18 @@
+import Foundation
+import Combine
+
+final class SmokeTestController {
+    private var cancellables = Set<AnyCancellable>()
+    private let subject = PassthroughSubject<Int, Never>()
+    private var total = 0
+
+    func start() {
+        subject
+            .sink { value in
+                self.total += value
+            }
+            .store(in: &cancellables)
+    }
+}
